{
  "name": "shippified-sdk",
  "version": "0.2.2",
  "description": "TypeScript client for the Shippified REST API: orders, tracking, email intake, templates, webhooks, share cards.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "shippified",
    "reseller",
    "order tracking",
    "discord webhook",
    "tracking",
    "carrier api"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Shippified/shippified-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shippified/shippified-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Shippified/shippified-sdk/issues"
  }
}
